# --- LLM providers (agent service) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- SEC EDGAR fair-access policy: identify yourself (name + email) ---
SEC_USER_AGENT="Your Name your.email@example.com"

# --- Postgres ---
POSTGRES_PASSWORD=agentlens

# --- Gateway ---
# Single admin API key for v1 (only a hash is stored). Generate: openssl rand -hex 32
ADMIN_API_KEY=
# Hard daily spend ceiling across all runs (USD). Gateway refuses new runs past this.
DAILY_COST_CAP_USD=5

# Browser origins allowed to call the gateway (comma-separated; "*" is refused)
ALLOWED_ORIGINS=http://localhost:4200
